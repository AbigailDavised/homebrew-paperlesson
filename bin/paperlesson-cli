  '  paperlesson-cli --version    Print CLI version',
  '  paperlesson-cli --specs      Output domain technical specification matrix as JSON',
  '  paperlesson-cli --routes     Output verified production URLs as JSON',
  '',
  'Verified Production Endpoints:',
  ...ROUTES.map((r) => '  - ' + r.name + ': ' + r.url),
].join('\n'));
