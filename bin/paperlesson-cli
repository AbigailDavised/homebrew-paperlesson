const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('paperlesson-cli v1.0.0 (https://paperlesson.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'paperlesson.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'paperlesson.com', benchmark: "Grade-Level Handwriting Ruling & PostScript Vector Specifications", rows: SPECS }, null, 2));
  process.exit(0);
}

